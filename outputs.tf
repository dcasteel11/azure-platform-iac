# -----------------------------------------------------------------------------
# Root outputs
#
# Shown after "terraform plan" or "terraform apply" and readable with
# "terraform output". Handy for checking names before anything is created.
# -----------------------------------------------------------------------------

output "names" {
  description = "Resource names generated by the naming module."
  value       = module.naming.names
}

output "tags" {
  description = "Tags applied to every resource."
  value       = module.naming.tags
}

output "resource_group_names" {
  description = "Map of purpose to resource group name, for example resource_group_names.core."
  value       = module.resource_groups.names
}

output "resource_group_ids" {
  description = "Map of purpose to resource group ID."
  value       = module.resource_groups.ids
}

output "budget_name" {
  description = "Name of the subscription budget, or null when budget_enabled is false."
  value       = one(module.budget[*].name)
}

output "log_analytics_workspace_name" {
  description = "Name of the environment's Log Analytics workspace."
  value       = module.log_analytics.name
}

output "log_analytics_workspace_id" {
  description = "Resource ID of the Log Analytics workspace, used by diagnostic settings in later steps."
  value       = module.log_analytics.id
}

output "hub_vnet_name" {
  description = "Name of the hub virtual network."
  value       = module.network.hub_vnet_name
}

output "subnet_ids" {
  description = "Subnet IDs keyed by \"role/subnet\", for example subnet_ids[\"app/private-endpoints\"]. Used by private endpoints in later steps."
  value       = module.network.subnet_ids
}
